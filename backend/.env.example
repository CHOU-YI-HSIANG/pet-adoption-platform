# Backend environment example for local development and CI
# Copy this file to `.env` inside `backend/` and fill real secrets before running.

# Application
PORT=5000
NODE_ENV=development

# MongoDB
# Example: mongodb://localhost:27017/pet_adoption or Atlas connection string
MONGODB_URI=mongodb://localhost:27017/pet_adoption

# Session / JWT
SESSION_SECRET=change_me_to_a_secure_value
JWT_SECRET=change_me_to_a_secure_value

# OAuth (if used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend origin(s) (comma separated)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# DB connection retry behavior (tune for CI or slow networks)
# Default: 5 retries, 2000ms initial delay
DB_CONNECT_MAX_RETRIES=5
DB_CONNECT_DELAY_MS=2000

# Readiness polling for integration tests
# Default: 20 retries, 1000ms delay
READINESS_RETRIES=20
READINESS_DELAY_MS=1000

# Optional: other tuning
# LOG_LEVEL=info
# 環境設定
NODE_ENV=development
PORT=5000

# 資料庫設定
MONGODB_URI=mongodb://localhost:27017/pet_adoption

# JWT 密鑰
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# 檔案上傳設定
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# 前端 URL (用於 CORS)
FRONTEND_URL=http://localhost:3000# MongoDB
MONGODB_URI=mongodb://localhost:27017/pet_adoption

# JWT
JWT_SECRET=your-jwt-secret-key

# Session
SESSION_SECRET=your-session-secret-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend
FRONTEND_URL=http://localhost:3000

# Server
PORT=5000
NODE_ENV=development
