async function seedDatabase() {
  try {
    // 連接資料庫
    await mongoose.connect(process.env.MONGODB_URI || 'mongodb://localhost:27017/pet_adoption');
    console.log(' 已連接到 MongoDB');

    // 尋找或建立示範收容所帳號
    let shelterUser = await User.findOne({ email: 'shelter@example.com' });
    
    if (!shelterUser) {
      console.log(' 建立示範收容所帳號...');
      const bcrypt = require('bcryptjs');
      const hashedPassword = await bcrypt.hash('shelter123', 10);
      
      shelterUser = await User.create({
        name: '愛心動物之家',
        email: 'shelter@example.com',
        password: hashedPassword,
        role: 'shelter',
        phone: '02-12345678',
        address: '台北市信義區',
        shelterInfo: {
          shelterName: '愛心動物之家',
          licenseNumber: 'SH-2024-001',
          address: '台北市信義區信義路五段100號',
          phone: '02-12345678',
          capacity: 50,
          established: new Date('2020-01-01')
        }
      });
      console.log(' 收容所帳號建立成功');
      console.log('   帳號: shelter@example.com');
      console.log('   密碼: shelter123');
    } else {
      console.log(' 使用現有收容所帳號');
    }

    // 清除舊資料 (可選)
    const confirmClear = process.argv.includes('--clear');
    if (confirmClear) {
      await Pet.deleteMany({});
      console.log('  已清除舊的寵物資料');
    }

    // 新增寵物資料
    console.log('\n📝 開始載入寵物資料...');
    
    for (const petData of samplePets) {
      const pet = await Pet.create({
        ...petData,
        shelter: shelterUser._id
      });
      console.log(`✅ 已新增: ${pet.name} (${pet.species} - ${pet.breed})`);
    }

    console.log(`\n🎉 成功載入 ${samplePets.length} 隻寵物資料!`);
    console.log('\n📊 摘要:');
    const dogCount = samplePets.filter(p => p.species === '狗').length;
    const catCount = samplePets.filter(p => p.species === '貓').length;
    console.log(`   狗: ${dogCount} 隻`);
    console.log(`   貓: ${catCount} 隻`);
    
    console.log('\n🌐 您現在可以:');
    console.log('   1. 前往 http://localhost:3000/pets 查看寵物列表');
    console.log('   2. 使用 shelter@example.com / shelter123 登入收容所帳號');
    console.log('   3. 建立一般用戶帳號來測試認養功能');

  } catch (error) {
    console.error('❌ 錯誤:', error.message);
    console.error(error);
  } finally {
    await mongoose.connection.close();
    console.log('\n👋 資料庫連接已關閉');
  }
}

// 執行
seedDatabase();
